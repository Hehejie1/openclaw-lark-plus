{
  "name": "@hehejie/openclaw-lark-plus",
  "version": "2026.4.1-hehejie.2",
  "description": "OpenClaw Lark/Feishu enhancement plugin with immediate progress cards",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "openclaw-lark-plus": "bin/openclaw-lark.js",
    "openclaw-lark-plus-release": "bin/openclaw-lark-plus-release.js"
  },
  "files": [
    "bin/",
    "dist/",
    "skills/",
    "scripts/publish-helper.mjs",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "release": "node scripts/publish-helper.mjs release:all",
    "dev:link": "openclaw plugins install --link --dangerously-force-unsafe-install .",
    "release:fork": "node scripts/publish-helper.mjs fork",
    "release:login:npm": "node scripts/publish-helper.mjs login:npm",
    "release:login:github": "node scripts/publish-helper.mjs login:github",
    "release:npm": "node scripts/publish-helper.mjs publish:npm",
    "release:github": "node scripts/publish-helper.mjs publish:github",
    "release:check": "node scripts/publish-helper.mjs check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ index.ts",
    "lint:fix": "eslint src/ index.ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@sinclair/typebox": "0.34.48",
    "image-size": "^2.0.2",
    "undici-types": "^8.1.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.22"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.3",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.39.3",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^17.24.0",
    "execa": "^9.6.0",
    "fs-extra": "^11.3.2",
    "globals": "^16.2.0",
    "minimist": "^1.2.8",
    "openclaw": "^2026.4.9",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^4.1.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.mjs"
    ],
    "install": {
      "npmSpec": "@hehejie/openclaw-lark-plus",
      "localPath": "extensions/openclaw-lark-plus",
      "defaultChoice": "npm"
    }
  }
}
